# Local development. settings.py resolves every secret from the process
# environment first, then this file, then Key Vault. `make run` needs nothing
# but the two GitHub App values below.
#
# Never commit a filled-in copy. .gitignore excludes .env and .env.*, and lets
# this template through.

# Optional. Where the scan remembers what it saw last week, so the digest can
# say what is new and what has been resolved. Unset means every finding reports
# as new, which is the right default locally — and `render` never writes to it
# in any case. `terraform output -raw state_container_url` gives the value.
# STATE_CONTAINER_URL=https://strepoagentdev.blob.core.windows.net/state

# Optional, and the alternative to filling in anything below it: point at the
# project's Key Vault and the secrets resolve from there using your own `az
# login`, so no private key is written to disk. Leave it unset to work fully
# offline.
# KEY_VAULT_URI=https://kv-repoagent-dev.vault.azure.net/

# From the GitHub App's settings page.
GITHUB_APP_ID=

# The App's private key, as a PEM. Multi-line, so quote it:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END..."
GITHUB_APP_PRIVATE_KEY=

# Only needed for `repoagent scan`; `repoagent render` sends nothing.
RESEND_API_KEY=
DIGEST_EMAIL_TO=

# Optional. Absent means the digest goes out with its findings in check order
# and no commentary, which is the right default locally — the checks are what
# produce every fact in the email, and triage only reorders and summarises them.
# Note what a key here switches on: repository names, findings, and truncated
# Renovate config, README and Dockerfile text are sent to DeepSeek.
DEEPSEEK_API_KEY=
