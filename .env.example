# Local development. settings.py reads every secret from the environment first
# and only then from Key Vault, which is what makes this work with no Azure at
# all: `make run` needs nothing but the two GitHub App values below.
#
# Never commit a filled-in copy. .gitignore excludes .env and .env.*, and lets
# this template through.

# From the GitHub App's settings page.
GITHUB_APP_ID=

# The App's private key, as a PEM. Multi-line, so quote it:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END..."
GITHUB_APP_PRIVATE_KEY=

# Only needed for `repoagent scan`; `repoagent render` sends nothing.
RESEND_API_KEY=
DIGEST_EMAIL_TO=

# Optional. Absent means the digest goes out with its findings in check order
# and no commentary, which is the right default locally — the checks are what
# produce every fact in the email, and triage only reorders and summarises them.
# Note what a key here switches on: repository names, findings, and truncated
# Renovate config, README and Dockerfile text are sent to DeepSeek.
DEEPSEEK_API_KEY=
